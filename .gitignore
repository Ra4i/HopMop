# .gitignore for HopMop (ASP.NET Core / Visual Studio)
# Keep local secrets, build outputs and editor files out of git

# Build artifacts
bin/
obj/
out/

# Publish output
publish/

# User-specific files
*.user
*.suo
*.userosscache
*.sln.docstates

# Visual Studio
.vs/

# Visual Studio Code
.vscode/

# JetBrains Rider
.idea/
*.iml

# ReSharper
_ReSharper*/
*ReSharper*/

# NuGet packages
*.nupkg
packages/

# Node
node_modules/

# Logs
*.log
logs/

# Database files (SQLite)
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
hopmop.db

# Data protection key ring — these sign the auth cookies and are secrets.
keys/

# Admin-uploaded gallery images. The few sample images already committed stay
# tracked; this only stops new uploads from being committed by accident.
# On a server this folder must be backed by persistent storage.
wwwroot/uploads/

# Environment files and local overrides
.env
.env.*
!.env.example
.env.local
.env.development.local
.env.production.local

# ASP.NET Core user secrets file
secrets.json

# appsettings local/dev files
appsettings.Development.json
appsettings.Local.json

# Certificates and keys
*.pfx
*.key

# Ignore publishing and temporary files
*.publishsettings
*.wapproj

# OS files
Thumbs.db
Desktop.ini
.DS_Store

# Ignore temporary files created by editors
*~
*.swp


# Local MCP server configuration -- kept out of the repo on request.
.mcp.json
