@model IEnumerable<HopMop.Models.PhotoPair>
@{
    ViewBag.Title = "Admin Dashboard";
}
<h1>Административен панел</h1>
<div class="toolbar">
    <a class="btn primary" href="/Admin/Upload">Качване на нова двойка снимки</a>
    @if (Context.User.HasClaim("IsAdmin", "True")) {
        <a class="btn primary" href="/Admin/Inquiries">Запитвания</a>
        <a class="btn primary" href="/Users">Потребители</a>
    }
</div>
<div class="table-wrap">
<table class="admin-table">
    <thead><tr><th>Заглавие</th><th>Качено</th><th>Действия</th></tr></thead>
    <tbody>
    @foreach(var p in Model) {
        <tr>
            <td>@p.Title</td>
            <td>@p.CreatedAt.ToLocalTime()</td>
            <td>
                @if (Context.User.HasClaim("IsAdmin", "True")) {
                    <form method="post" asp-action="Delete" asp-route-id="@p.Id" onsubmit="return confirm('Изтриване?');">
                        <button class="btn danger sm" type="submit">Изтрий</button>
                    </form>
                }
            </td>
        </tr>
    }
    </tbody>
</table>
</div>
