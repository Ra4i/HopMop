@{
    ViewBag.Title = "Admin Login";
}
<h1>Вход за администратор</h1>
<p class="lede">Въведете вашия email и парола, за да управлявате сайта.</p>

@if (!ViewData.ModelState.IsValid) {
    <div class="notice error">
        <div>
            <strong>Нещо не е наред:</strong>
            <ul class="error-list">
                @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@err.ErrorMessage</li>
                }
            </ul>
        </div>
    </div>
}

<section class="panel narrow">
    <div class="panel-head">
        <span class="panel-icon" aria-hidden="true">🔑</span>
        <h2>Вход в системата</h2>
    </div>
    <form method="post" asp-controller="Account" asp-action="Login">
        @* Carries the page the visitor was sent here from. The controller only
           honours it when Url.IsLocalUrl says it points back at this site. *@
        <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
        <label class="field">
            <span class="field-label">Email</span>
            <input name="email" type="email" required autocomplete="username" placeholder="name@example.com" />
        </label>
        <label class="field">
            <span class="field-label">Парола</span>
            <input name="password" type="password" required autocomplete="current-password" />
        </label>
        <button class="btn primary" type="submit">Вход</button>
    </form>
</section>
