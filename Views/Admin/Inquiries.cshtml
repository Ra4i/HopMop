@model IEnumerable<HopMop.Models.Inquiry>
@{
    ViewBag.Title = "Inquiries";

    var inquiries = Model.ToList();
}
<h1>Запитвания</h1>
<div class="toolbar">
    <a class="btn primary" href="/Admin">Назад към панела</a>
    <a class="btn" href="/Admin/ResolvedInquiries">Завършени запитвания</a>
    <a class="btn primary" href="/Users">Потребители</a>
</div>

@if (inquiries.Count == 0)
{
    <div class="inq-empty">
        <span class="inq-empty-icon" aria-hidden="true">✉️</span>
        <h3>Няма активни запитвания</h3>
        <p>Новите съобщения от формата за контакт ще се появяват тук.</p>
    </div>
}
else
{
    <p class="inq-count">Активни запитвания <span class="badge gold">@inquiries.Count</span></p>

    @* Cards ship expanded; inquiries.js collapses them and turns the headers
       into toggles, so the page stays fully readable without JavaScript. *@
    <div class="inq-list" id="inquiry-list">
        @foreach (var i in inquiries)
        {
            <partial name="_InquiryCard" model="i" />
        }
    </div>
}
