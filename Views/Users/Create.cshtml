@{
    ViewBag.Title = "Create User";
}
<h1>Създай потребител</h1>
@if (!ViewData.ModelState.IsValid) {
    <div class="notice error">@ViewData.ModelState[""]?.Errors.FirstOrDefault()?.ErrorMessage</div>
}
<form method="post">
    <label>Email<input name="email" type="email" required /></label>
    <label>Парола<input name="password" type="password" required /></label>
    <label class="check"><input name="isAdmin" type="checkbox" value="true" />Администратор</label>
    <button class="btn primary" type="submit">Създай</button>
</form>
<p><a href="/Users">Назад към потребителите</a></p>
