@using Microsoft.Extensions.Configuration
@inject IConfiguration Config
@model HopMop.Models.Inquiry
@{
    ViewBag.Title = "Контакти - HopMop";

    var phone = Config["Site:Phone"] ?? "+359 87 900 3512";
    var phoneHref = "tel:" + phone.Replace(" ", string.Empty);
    var viberChat = Config["Site:ViberChatUrl"];
    <!-- 0 87 900 3512 -->
}
<h1>Свържете се с нас</h1>
<p class="lede">Опишете накратко от какво имате нужда и ще се свържем с вас с оферта.</p>

@if (TempData["Success"] != null) {
    <div class="notice success">@TempData["Success"]</div>
}

@* Validation failures are shown back to the visitor instead of silently
   re-rendering an unchanged form. *@
@if (!ViewData.ModelState.IsValid) {
    <div class="notice error">
        <div>
            <strong>Проверете попълненото:</strong>
            <ul class="error-list">
                @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@err.ErrorMessage</li>
                }
            </ul>
        </div>
    </div>
}

<div class="field-row contact-row">

    <section class="panel">
        <div class="panel-head">
            <span class="panel-icon" aria-hidden="true">✉️</span>
            <h2>Изпратете запитване</h2>
        </div>
        <form method="post" asp-action="ContactSubmit">
            <label class="field">
                <span class="field-label">Име</span>
                <input name="Name" value="@Model?.Name" required maxlength="100" autocomplete="name" placeholder="Например: Мария Иванова" />
            </label>
            <label class="field">
                <span class="field-label">Email</span>
                <input type="email" name="Email" value="@Model?.Email" required maxlength="254" autocomplete="email" placeholder="name@example.com" />
                <small class="hint">На този адрес ще получите отговор.</small>
            </label>
            <label class="field">
                <span class="field-label">Телефон <em class="optional">(може да пропуснете)</em></span>
                <input name="Phone" value="@Model?.Phone" maxlength="32" autocomplete="tel" placeholder="@phone" />
            </label>
            <label class="field">
                <span class="field-label">Съобщение</span>
                <textarea name="Message" rows="4" required maxlength="4000" placeholder="Например: Търся основно почистване на двустаен апартамент в Люлин.">@Model?.Message</textarea>
                <small class="hint">Опишете площта и услугата, за да ви дадем точна цена.</small>
            </label>
            <button class="btn primary" type="submit">Изпрати запитването</button>
        </form>
    </section>

    <section class="panel contact-info">
        <div class="panel-head"> 
            <span class="panel-icon" aria-hidden="true">⚡</span>
            <h2>Бързи действия</h2>
        </div>
        <p>Ако предпочитате, свържете се директно — отговаряме и по телефон, и по Viber.</p>
        <p>Телефон: <a href="@phoneHref">@phone</a></p>
        @if (!string.IsNullOrWhiteSpace(viberChat))
        {
            <p>Viber: <a href="@viberChat" rel="noopener noreferrer">Отвори в Viber</a></p>
        }
    </section>

</div>
