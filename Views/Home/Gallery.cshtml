@model IEnumerable<HopMop.Models.PhotoPair>
@{
    ViewBag.Title = "Галерия - ПРЕДИ / СЛЕД";
}
<h1>Преди / След</h1>
@if (!Model.Any()) {
    <p>Няма качени снимки още. Администраторът може да качи снимки от панела.</p>
} else {
    <div class="gallery-grid">
        @foreach(var item in Model) {
            <div class="pair">
                <h3>@item.Title</h3>
                <p>@item.Description</p>
                <div class="ba-slider" data-before="@item.BeforeImagePath" data-after="@item.AfterImagePath">
                    <img class="before" src="@item.BeforeImagePath" alt="Before - @item.Title" />
                    <img class="after" src="@item.AfterImagePath" alt="After - @item.Title" />
                    <div class="slider-handle"></div>
                </div>
            </div>
        }
    </div>
}
