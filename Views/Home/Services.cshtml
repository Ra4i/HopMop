@using Microsoft.Extensions.Configuration
@inject IConfiguration Config
@{
    ViewBag.Title = "Услуги - HopMop";

    var phone = Config["Site:Phone"] ?? "+359 87 900 3512";
    var phoneHref = "tel:" + phone.Replace(" ", string.Empty);
    var viberChat = Config["Site:ViberChatUrl"];
}
<h1>Услуги</h1>
<p class="lede">Предлагаме широка гама от почистващи услуги, оптимизирани за домове и бизнес.</p>

<section class="panel">
    <div class="panel-head">
        <span class="panel-icon" aria-hidden="true">🧽</span>
        <h2>Какво почистваме</h2>
    </div>
    <ul>
        <li>Основно почистване</li>
        <li>Абонаментно почистване</li>
        <li>Почистване след ремонт</li>
        <li>Почистване на офиси и търговски площи</li>
        <li>Пране и почистване на мека мебел</li>
        <li>Измиване на прозорци и витрини</li>
    </ul>
</section>

<section class="panel">
    <div class="panel-head">
        <span class="panel-icon" aria-hidden="true">📞</span>
        <h2>Искате оферта?</h2>
    </div>
    <p>За индивидуална оферта използвайте формата за контакт или се обадете директно — ще ви отговорим в рамките на деня.</p>
    <div class="toolbar">
        <a class="btn primary" href="/Home/Contact">Изпратете запитване</a>
        <a class="btn outline" href="@phoneHref">Обадете се</a>
        @if (!string.IsNullOrWhiteSpace(viberChat))
        {
            <a class="btn outline" href="@viberChat" rel="noopener noreferrer">Пишете ни във Viber</a>
        }
    </div>
</section>
