@using Microsoft.Extensions.Configuration
@inject IConfiguration Config
@{
    // Contact details live in configuration so they can be corrected in one
    // place (appsettings.json or a Site__Phone environment variable) rather
    // than being hard-coded into every view.
    var phone = Config["Site:Phone"] ?? "+359 88 800 0000";
    var phoneHref = "tel:" + phone.Replace(" ", string.Empty);
    var viberChat = Config["Site:ViberChatUrl"];
}
<!DOCTYPE html>
<html lang="bg">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    @* The parentheses matter: without them Razor renders the expression as
       "<title>" plus the literal text ?? "HopMop Ltd." *@
    <title>@(ViewBag.Title ?? "HopMop Ltd.")</title>
    <meta name="description" content="Почистване София - HopMop ЕООД. Професионална почистваща фирма за домове и бизнес." />
    <meta property="og:title" content="HopMop Ltd. - Чистота, на която можеш да разчиташ!" />
    <meta property="og:description" content="Почистване София, основно почистване, почистване след ремонт. HopMop ЕООД" />
    @* asp-append-version adds a content hash to the URL, so the browser fetches
       a fresh copy whenever the file actually changes instead of serving a cached one. *@
    <link rel="stylesheet" href="/css/site.css" asp-append-version="true" />
    <script src="/js/site.js" defer asp-append-version="true"></script>
    <script src="/js/gallery.js" defer asp-append-version="true"></script>
    <script src="/js/upload.js" defer asp-append-version="true"></script>
    <script src="/js/inquiries.js" defer asp-append-version="true"></script>
</head>
<body>
    <header class="site-header">
        <div class="container nav-row">
            <a class="brand" href="/">
                <span class="logo-mark" aria-hidden="true">HM</span>
                <span class="brand-text">HopMop Ltd. <span class="bg">ХопМоп ЕООД</span></span>
            </a>
            <label class="nav-burger" for="nav-toggle" title="Меню"><span></span></label>
            <label class="nav-scrim" for="nav-toggle" aria-hidden="true"></label>
            <nav class="main-nav">
                <a href="/">Начало</a>
                <a href="/Home/About">За нас</a>
                <a href="/Home/Services">Услуги</a>
                <a href="/Home/Gallery">Преди / След</a>
                <a href="/Home/Contact">Контакти</a>
            </nav>
            <div class="header-cta">
                <a class="phone" href="@phoneHref">@phone</a>
                @if (!string.IsNullOrWhiteSpace(viberChat))
                {
                    <a class="viber" href="@viberChat" rel="noopener noreferrer">Viber</a>
                }
            </div>
        </div>
    </header>

    <main>
        <div class="container">
            @RenderBody()
        </div>
    </main>

    <footer class="site-footer">
        <div class="container">
            <p>© @DateTime.Now.Year HopMop Ltd. — Чистота, на която можеш да разчиташ! | София и регион</p>
        </div>
    </footer>

    <!-- Sticky action buttons -->
    <div class="sticky-actions">
        <a class="sticky-phone" href="@phoneHref" aria-label="Обади се">📞</a>
        @if (!string.IsNullOrWhiteSpace(viberChat))
        {
            <a class="sticky-viber" href="@viberChat" aria-label="Viber">💬</a>
        }
    </div>
</body>
</html>
