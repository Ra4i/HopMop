# Copy this file to .env and fill in your local secrets.
# Do not commit .env to source control.

Admin__DefaultEmail=your-admin@example.com
Admin__DefaultPassword=your-strong-password

Smtp__Host=smtp.example.com
Smtp__Port=587
Smtp__Username=your-smtp-username
Smtp__Password=your-smtp-password
Smtp__From=noreply@example.com
