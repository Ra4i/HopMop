# Copy this file to .env and fill in your local values.
# .env is for LOCAL DEVELOPMENT ONLY — never commit it, and never ship it to a
# server. On a server, set these as real environment variables instead.
#
# ASP.NET Core maps a double underscore (__) to a nested config section:
#   Admin__DefaultEmail  ->  Admin:DefaultEmail
#
# Values already present in the real environment always win over this file, so a
# stray .env on a server cannot override what the host sets.

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
# Development enables the detailed error page. NEVER set this on a public server.
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=https://localhost:50327;http://localhost:50328

# ---------------------------------------------------------------------------
# Database — Neon PostgreSQL
# ---------------------------------------------------------------------------
# Paste the connection string straight from the Neon dashboard. Both forms it
# offers are accepted and normalised at startup:
#
#   postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/dbname?sslmode=require
#   Host=ep-xxx-pooler.eu-central-1.aws.neon.tech;Database=dbname;Username=user;Password=password
#
# Prefer the "Pooled connection" string from the dashboard — the app opens a
# connection per request and the pooled endpoint is what that is for.
#
# TLS is not optional on Neon, and the app raises the connection to
# SSL Mode=VerifyFull on its own, so there is nothing to add for that.
ConnectionStrings__DefaultConnection=postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/dbname?sslmode=require

# DATABASE_URL is read as a fallback, so an environment provisioned by Neon's own
# Vercel integration works without renaming anything. The key above wins when both
# are set.
# DATABASE_URL=

# ---------------------------------------------------------------------------
# First admin account
# ---------------------------------------------------------------------------
# Used ONCE, only when the Users table is empty. After the first admin exists,
# further accounts are created from the /Users page and these can be removed.
# Use a long, unique password — minimum 10 characters.
Admin__DefaultEmail=your-admin@example.com
Admin__DefaultPassword=change-me-to-something-long

# ---------------------------------------------------------------------------
# Public contact details shown on the site
# ---------------------------------------------------------------------------
# The Viber number is the phone number with spaces removed and the leading + as
# %2B, so the two stay in step: +359 87 900 3512 -> %2B359879003512
Site__Phone=+359 87 900 3512
Site__ViberChatUrl=viber://chat?number=%2B359879003512

# ---------------------------------------------------------------------------
# Optional overrides
# ---------------------------------------------------------------------------
# Set to false only if your proxy terminates TLS but does not send
# X-Forwarded-Proto — otherwise the app and the proxy loop redirecting.
# Security__RequireHttps=true

# Port the HTTPS redirect points at. Change only if TLS is on a non-standard port.
# Security__HttpsPort=443

# Where the cookie-signing keys are stored. Point this at a persistent volume
# so a redeploy does not sign everyone out.
# DataProtection__KeyRingPath=/data/keys

# Keeps a weaker SSL Mode from the connection string instead of raising it to
# VerifyFull. Only for a runtime with no usable CA bundle, where certificate
# validation cannot succeed at all — it gives up protection against connecting
# to an impostor server.
# Database__AllowUnverifiedTls=false
